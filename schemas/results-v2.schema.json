{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cmkrause.github.io/scratch-feedback/schemas/results-v2.schema.json",
  "title": "Scratch Feedback results, version 2",
  "description": "Machine-readable results embedded in a completed Scratch Feedback PDF.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "scratch-feedback-results"
    },
    "schemaVersion": {
      "const": 2
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "mode": {
      "enum": [
        "activity",
        "example",
        "preview"
      ]
    },
    "activity": {
      "$ref": "#/$defs/activity"
    },
    "summary": {
      "$ref": "#/$defs/summary"
    },
    "questions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "$ref": "#/$defs/question"
      }
    }
  },
  "required": [
    "format",
    "schemaVersion",
    "generatedAt",
    "mode",
    "activity",
    "summary",
    "questions"
  ],
  "$defs": {
    "activity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://[^#]+#/activity/[A-Za-z0-9_-]+$"
        },
        "configurationHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "pointsByAttempt": {
          "type": "array",
          "minItems": 2,
          "maxItems": 10,
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 10000
          }
        }
      },
      "required": [
        "url",
        "configurationHash",
        "title",
        "pointsByAttempt"
      ]
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pointsEarned": {
          "type": "number",
          "minimum": 0,
          "maximum": 2000000
        },
        "pointsPossible": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 2000000
        }
      },
      "required": [
        "pointsEarned",
        "pointsPossible"
      ]
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "number": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100198
        },
        "attempts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-J]$"
          }
        },
        "automaticReveal": {
          "type": "boolean"
        },
        "pointsEarned": {
          "type": "number",
          "minimum": 0,
          "maximum": 10000
        }
      },
      "required": [
        "number",
        "attempts",
        "automaticReveal",
        "pointsEarned"
      ]
    }
  }
}
